{
  "name": "bookkeeping-app",
  "version": "0.4.0",
  "description": "Desktop bookkeeping for accountants managing multiple companies",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.bookkeeping.app",
    "productName": "Bookkeeping",
    "files": [
      "out/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "books",
        "name": "Bookkeeping Company File"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Bookkeeping-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bookkeeping"
    },
    "publish": null
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "author": "Geoff"
}
